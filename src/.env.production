# ============================================================
# 📁 File: src/.env.production
# 🚀 Production build — used by Netlify
# ============================================================

# In production, the frontend uses /api (relative). Netlify proxies
# it to InfinityFree server-side, avoiding CORS entirely.
# Do NOT set VITE_API_BASE_URL to the InfinityFree URL here.

VITE_PUBLIC_BASE_URL=https://siaposkok.netlify.app
VITE_MEDIA_BASE_URL=/media

VITE_APP_NAME=Smart POS
VITE_APP_VERSION=1.3
VITE_PROCUREMENT_ENABLED=true