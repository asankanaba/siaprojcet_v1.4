# ============================================================
# 📁 File: .env.production
# 🚀 Values used when building for Netlify
# ============================================================

# Backend API (InfinityFree)
VITE_API_BASE_URL=https://smartpossiaaaa.kesug.com/smart-pos-api/api
VITE_API_BASE_URL2=https://smartpossiaaaa.kesug.com/smart-pos-api/api
VITE_MEDIA_BASE_URL=https://smartpossiaaaa.kesug.com/smart-pos-api

# Public base URL — used by LinkedIn share links
# After you deploy, replace this with your actual Netlify URL, e.g.:
#   VITE_PUBLIC_BASE_URL=https://smart-pos-yourname.netlify.app
# Until then, it falls back to window.location.origin at runtime.
VITE_PUBLIC_BASE_URL=https://smart-pos-yourname.netlify.app